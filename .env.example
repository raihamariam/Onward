# Onward — required environment variables, by component.
# Copy this file to .env (root, gitignored) and to each service as needed.
# Never commit real values. See CLAUDE.md §15 for how these are used.

# ---- Supabase (data layer: Postgres + Storage + pgvector) ----
# From your Supabase project settings > API.
# Current (2026) Supabase API key system — not the legacy anon/service_role
# names. PUBLISHABLE_KEY is the anon-key replacement (safe in untrusted/
# client contexts where the architecture actually calls for that) — used
# server-side by apps/web (app/incidents/[id]/page.tsx) for direct, RLS-
# protected reads (CLAUDE.md's reads-vs-writes split). SECRET_KEY is the
# service_role replacement and must stay server-only: used by n8n's Supabase
# credential (WF-01) for writes, never by decision-engine (stateless, never
# touches Supabase) and never by the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Model provider for incident interpretation (services/decision-engine) ----
# Default is Groq (qwen/qwen3.8-27b) — the zero-spend runtime requirement
# (CLAUDE.md §7): Onward's running system must not bill against the
# Anthropic API/subscription. Free tier: https://console.groq.com/keys
# Gemini was the original default but its free-tier daily quota proved too
# low for development/live-gate testing (~20 requests/day on this project's
# key) — see services/decision-engine/app/interpret/providers/gemini.py.
# IMPORTANT data-handling rule (same reasoning as Gemini's free tier): only
# ever send synthetic/non-sensitive hackathon data through a free-tier key —
# never real user reports. See CLAUDE.md §7.
GROQ_API_KEY=
# Optional — only needed to override the default. "groq" (default),
# "gemini", or "anthropic" (the latter two require their own key below;
# both remain fully implemented, just not active).
MODEL_PROVIDER=
# Only used if MODEL_PROVIDER=gemini. Not the active default — kept working
# rather than deleted, per CLAUDE.md's provider-abstraction design.
GEMINI_API_KEY=
# Only used if MODEL_PROVIDER=anthropic. Not the active default; bills
# against the Anthropic API.
ANTHROPIC_API_KEY=

# ---- Embeddings provider for pgvector retrieval ----
# Deferred (CLAUDE.md §7) — no manuals exist yet to index. Leave unset.
EMBEDDINGS_API_KEY=

# ---- n8n ----
# n8n Cloud workspace is already connected via this Claude Code session's
# MCP integration for workflow management. Runtime credentials for Postgres/
# Anthropic/Slack/Calendar/Gmail are configured inside n8n's own credential
# store (not here) once those workflows are built — see CLAUDE.md §9.
N8N_WEBHOOK_BASE_URL=
# Full webhook URL for WF-01 (Phase 2). Read server-side only, by
# apps/web/app/api/report/route.ts, which proxies the browser form's
# submission to it — NOT NEXT_PUBLIC_-prefixed, and deliberately so: Next.js
# only inlines NEXT_PUBLIC_ vars it finds by scanning .env files inside
# apps/web itself, which this repo's single root-level .env is not, so that
# inlining silently never fires here. Routing the call through a tiny
# server-side proxy sidesteps that entirely rather than fighting it.
INCIDENT_WEBHOOK_URL=

# ---- Google Calendar / Slack / Gmail (Phase 5 — M5, not needed yet) ----
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
SLACK_BOT_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Service URLs (local development) ----
DECISION_ENGINE_URL=http://127.0.0.1:8000
WEB_URL=http://127.0.0.1:3000
# n8n Cloud -> local decision-engine connectivity for gate testing: a free
# Cloudflare Quick Tunnel (`cloudflared tunnel --url http://localhost:8000`,
# no account/signup needed, no paid hosting). The tunnel prints a
# *.trycloudflare.com URL each run — paste "<that url>/incident/interpret"
# into WF-02's "Call Decision Engine" node when running the live gate.
# Not stored here since it's ephemeral (changes every time the tunnel
# restarts), not a stable config value.
