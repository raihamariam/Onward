{
  "id": "fMQ15943GzYcH6bw",
  "name": "WF-02 Incident Intelligence",
  "description": "Onward Phase 3: interprets a persisted incident using trusted asset context (registered asset + prior incidents for it) and, if the incident has a media_url, real image evidence. Calls decision-engine's /incident/interpret (the only place the model call lives, Gemini by default), then persists the result to incident_intelligence, separate from the user's original report. Idempotent — skips re-interpretation if intelligence already exists.",
  "active": true,
  "note": "Published and live-gate-tested (Phase 3, third pass — image intake). Two real bugs found and fixed during this pass: (1) Has Media?/Fetch Image/Encode Image lacked executeOnce and ran once per item from Fetch Prior Incidents (up to 5x) instead of once — fixed with executeOnce:true on 'Has Media?' alone, which naturally limits everything downstream to one item; (2) {{ $binary.data.data }} does not resolve to base64 in this instance's filesystem-v2 binary storage mode (confirmed live, not a display artifact) — replaced with the dedicated Extract from File node (binaryToPropery operation). 'Call Decision Engine' URL points at a Cloudflare Quick Tunnel (*.trycloudflare.com) — ephemeral, must be updated whenever the tunnel restarts.",
  "settings": { "executionOrder": "v1", "availableInMCP": true },
  "nodes": [
    { "id": "798123d5-4ddb-4047-a633-94ec8b76557d", "name": "Intelligence Trigger", "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.2, "position": [200, 400], "parameters": { "inputSource": "workflowInputs", "workflowInputs": { "values": [{ "name": "incident_id", "type": "string" }] } } },
    { "id": "903d59e3-aec8-442a-884e-940defcd31e0", "name": "Fetch Incident", "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [420, 400], "alwaysOutputData": true, "parameters": { "resource": "row", "operation": "getAll", "tableId": "incidents", "returnAll": false, "limit": 1, "filterType": "manual", "matchType": "allFilters", "filters": { "conditions": [{ "keyName": "id", "condition": "eq", "keyValue": "={{ $json.incident_id }}" }] } }, "credentials": { "supabaseApi": { "id": "dYRlahdtvOfzgkpw", "name": "Supabase (Onward)" } } },
    { "id": "c0517924-2808-4a6d-8dc2-59e5ebd43e68", "name": "Incident Found?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [640, 400], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.id }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" }] } } },
    { "id": "45feabad-f6dd-4e57-8e38-c7208c001733", "name": "Incident Not Found", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [860, 560], "parameters": { "mode": "raw", "jsonOutput": "={{ { error: 'incident_not_found' } }}" } },
    { "id": "962c6531-9bb3-403e-911b-3f6904306fd1", "name": "Check Existing Intelligence", "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [860, 340], "alwaysOutputData": true, "parameters": { "resource": "row", "operation": "getAll", "tableId": "incident_intelligence", "returnAll": false, "limit": 1, "filterType": "manual", "matchType": "allFilters", "filters": { "conditions": [{ "keyName": "incident_id", "condition": "eq", "keyValue": "={{ $(\"Fetch Incident\").item.json.id }}" }] } }, "credentials": { "supabaseApi": { "id": "dYRlahdtvOfzgkpw", "name": "Supabase (Onward)" } } },
    { "id": "b0508a5f-67dc-4467-ae4f-92a3c8bb15f8", "name": "Already Interpreted?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1080, 340], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "leftValue": "={{ $json.incident_id }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" }] } } },
    { "id": "69d0c5bf-45af-4a3f-a83f-75c8a4900a0b", "name": "Existing Intelligence", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1300, 240], "parameters": { "mode": "raw", "includeOtherFields": true, "jsonOutput": "={{ { source: \"existing\" } }}" } },
    { "id": "8c609abc-56e6-47b9-8dd2-cb9ff5d46582", "name": "Fetch Asset", "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [1300, 440], "alwaysOutputData": true, "parameters": { "resource": "row", "operation": "getAll", "tableId": "assets", "returnAll": false, "limit": 1, "filterType": "manual", "matchType": "allFilters", "filters": { "conditions": [{ "keyName": "id", "condition": "eq", "keyValue": "={{ $(\"Fetch Incident\").item.json.asset_id }}" }] } }, "credentials": { "supabaseApi": { "id": "dYRlahdtvOfzgkpw", "name": "Supabase (Onward)" } } },
    { "id": "7119cbca-030c-41d7-b6b4-25ad30069cda", "name": "Fetch Prior Incidents", "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [1520, 440], "parameters": { "resource": "row", "operation": "getAll", "tableId": "incidents", "returnAll": false, "limit": 5, "orderBy": "reported_at.desc", "filterType": "manual", "matchType": "allFilters", "filters": { "conditions": [{ "keyName": "asset_id", "condition": "eq", "keyValue": "={{ $(\"Fetch Incident\").item.json.asset_id }}" }, { "keyName": "id", "condition": "neq", "keyValue": "={{ $(\"Fetch Incident\").item.json.id }}" }] } }, "credentials": { "supabaseApi": { "id": "dYRlahdtvOfzgkpw", "name": "Supabase (Onward)" } } },
    { "id": "44572afd-5aca-4f5f-96fe-66d17494a615", "name": "Has Media?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1740, 300], "executeOnce": true, "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "combinator": "and", "conditions": [{ "leftValue": "={{ $(\"Fetch Incident\").item.json.media_url }}", "operator": { "type": "string", "operation": "notEmpty" }, "rightValue": "" }] } } },
    { "id": "11d84470-f329-40ec-a120-fec5b44b2e07", "name": "No Image", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1960, 400], "parameters": { "mode": "raw", "jsonOutput": "={{ { image_base64: null, image_media_type: null } }}" } },
    { "id": "f83fb683-dc74-44e6-bf04-4d034e4b1c7e", "name": "Fetch Image", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [1960, 220], "onError": "continueErrorOutput", "parameters": { "method": "GET", "url": "={{ $(\"Fetch Incident\").item.json.media_url }}", "options": { "response": { "response": { "responseFormat": "file", "outputPropertyName": "data" } }, "timeout": 20000 } } },
    { "id": "9b48bc99-7626-48f8-9721-78325f9b0e33", "name": "Image Fetch Failed", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [2180, 300], "parameters": { "mode": "raw", "jsonOutput": "={{ { image_base64: null, image_media_type: null } }}" } },
    { "id": "4a8a3345-8faa-4b24-a16e-dfd1f40c37a5", "name": "Extract Base64", "type": "n8n-nodes-base.extractFromFile", "typeVersion": 1.1, "position": [2180, 140], "parameters": { "operation": "binaryToPropery", "destinationKey": "image_base64" } },
    { "id": "f5ea6e6e-e116-4812-8305-6ba9b2f6641b", "name": "Finalize Image Fields", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [2400, 140], "parameters": { "mode": "raw", "jsonOutput": "={{ { image_base64: $json.image_base64, image_media_type: $('Fetch Image').item.binary.data.mimeType } }}" } },
    { "id": "14bb70fb-2c44-40e3-ae38-bbf5c1c11ed1", "name": "Call Decision Engine", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [1740, 440], "executeOnce": true, "onError": "continueErrorOutput", "parameters": { "method": "POST", "url": "https://instance-gui-preferred-indiana.trycloudflare.com/incident/interpret", "sendBody": true, "contentType": "json", "specifyBody": "json", "jsonBody": "={{ { incident_id: $('Fetch Incident').item.json.id, description: $('Fetch Incident').item.json.description, image_base64: $json.image_base64, image_media_type: $json.image_media_type, asset_context: { code: $('Fetch Asset').item.json.code, name: $('Fetch Asset').item.json.name, location: $('Fetch Asset').item.json.location, status: $('Fetch Asset').item.json.status, prior_incidents: $('Fetch Prior Incidents').all().map(i => ({ description: i.json.description, reported_at: i.json.reported_at, status: i.json.status })) } } }}", "options": { "timeout": 45000 } } },
    { "id": "f87c27f5-8c65-41f9-96f8-1c6cfe58977b", "name": "Call Failed", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [1960, 560], "parameters": { "mode": "raw", "jsonOutput": "={{ { error: 'decision_engine_unreachable' } }}" } },
    { "id": "e8eee553-722a-40a9-8760-3ca74a5e4096", "name": "Insert Intelligence", "type": "n8n-nodes-base.supabase", "typeVersion": 1, "position": [1960, 340], "onError": "continueErrorOutput", "parameters": { "resource": "row", "operation": "create", "tableId": "incident_intelligence", "dataToSend": "defineBelow", "fieldsUi": { "fieldValues": [
      { "fieldId": "incident_id", "fieldValue": "={{ $json.incident_id }}" },
      { "fieldId": "schema_version", "fieldValue": "={{ $json.schema_version }}" },
      { "fieldId": "incident_type", "fieldValue": "={{ $json.incident_type }}" },
      { "fieldId": "symptoms", "fieldValue": "={{ $json.symptoms }}" },
      { "fieldId": "visual_observations", "fieldValue": "={{ $json.visual_observations }}" },
      { "fieldId": "severity", "fieldValue": "={{ $json.severity }}" },
      { "fieldId": "safety_risk", "fieldValue": "={{ $json.safety_risk }}" },
      { "fieldId": "confidence", "fieldValue": "={{ $json.confidence }}" },
      { "fieldId": "likely_faults", "fieldValue": "={{ $json.likely_faults }}" },
      { "fieldId": "required_capability", "fieldValue": "={{ $json.required_capability }}" },
      { "fieldId": "requires_human_review", "fieldValue": "={{ $json.requires_human_review }}" },
      { "fieldId": "review_reason", "fieldValue": "={{ $json.review_reason }}" },
      { "fieldId": "evidence_conflict", "fieldValue": "={{ $json.evidence_conflict }}" },
      { "fieldId": "model", "fieldValue": "={{ $json.model }}" },
      { "fieldId": "provider", "fieldValue": "={{ $json.provider }}" },
      { "fieldId": "interpreted_at", "fieldValue": "={{ $json.interpreted_at }}" }
    ] } }, "credentials": { "supabaseApi": { "id": "dYRlahdtvOfzgkpw", "name": "Supabase (Onward)" } } },
    { "id": "3d76a055-dab1-4a3b-92f2-9b8ccd9ffcb4", "name": "Insert Failed", "type": "n8n-nodes-base.set", "typeVersion": 3.5, "position": [2180, 460], "parameters": { "mode": "raw", "jsonOutput": "={{ { error: 'intelligence_persist_failed' } }}" } }
  ],
  "connections": {
    "Intelligence Trigger": { "main": [[{ "node": "Fetch Incident", "type": "main", "index": 0 }]] },
    "Fetch Incident": { "main": [[{ "node": "Incident Found?", "type": "main", "index": 0 }]] },
    "Incident Found?": { "main": [[{ "node": "Check Existing Intelligence", "type": "main", "index": 0 }], [{ "node": "Incident Not Found", "type": "main", "index": 0 }]] },
    "Check Existing Intelligence": { "main": [[{ "node": "Already Interpreted?", "type": "main", "index": 0 }]] },
    "Already Interpreted?": { "main": [[{ "node": "Existing Intelligence", "type": "main", "index": 0 }], [{ "node": "Fetch Asset", "type": "main", "index": 0 }]] },
    "Fetch Asset": { "main": [[{ "node": "Fetch Prior Incidents", "type": "main", "index": 0 }]] },
    "Fetch Prior Incidents": { "main": [[{ "node": "Has Media?", "type": "main", "index": 0 }]] },
    "Has Media?": { "main": [[{ "node": "Fetch Image", "type": "main", "index": 0 }], [{ "node": "No Image", "type": "main", "index": 0 }]] },
    "Fetch Image": { "main": [[{ "node": "Extract Base64", "type": "main", "index": 0 }], [{ "node": "Image Fetch Failed", "type": "main", "index": 0 }]] },
    "Extract Base64": { "main": [[{ "node": "Finalize Image Fields", "type": "main", "index": 0 }]] },
    "Finalize Image Fields": { "main": [[{ "node": "Call Decision Engine", "type": "main", "index": 0 }]] },
    "Image Fetch Failed": { "main": [[{ "node": "Call Decision Engine", "type": "main", "index": 0 }]] },
    "No Image": { "main": [[{ "node": "Call Decision Engine", "type": "main", "index": 0 }]] },
    "Call Decision Engine": { "main": [[{ "node": "Insert Intelligence", "type": "main", "index": 0 }], [{ "node": "Call Failed", "type": "main", "index": 0 }]] },
    "Insert Intelligence": { "main": [[], [{ "node": "Insert Failed", "type": "main", "index": 0 }]] }
  }
